enum TipoEventoTimeline {
  MOVIMENTACAO
  PETICAO
  AUDIENCIA
  DECISAO
  SENTENCA
  DOCUMENTO
  COMENTARIO
  ALTERACAO_STATUS
  PRAZO
  ANOTACAO
  PERSONALIZADO
  // Adicionados na Sprint 08 (Deadlines + Timeline) — reafirma
  // docs/backend-implementation/19-decisions.md: extensão aditiva do enum
  // (migration manual `20260801000000_timeline_event_types`), nenhum valor
  // existente removido/renomeado. Cobrem os "eventos automáticos" pedidos
  // que não cabiam nos valores originais sem perder granularidade.
  CRIACAO_PROCESSO
  ATUALIZACAO_PROCESSO
  ALTERACAO_RESPONSAVEL
  ALTERACAO_PRIORIDADE
  CLIENTE_ATUALIZADO
  EQUIPE_ALTERADA
  SEGREDO_JUSTICA_ALTERADO
  ARQUIVAMENTO
  RESTAURACAO
  IA_EXECUTADA
  IMPORTACAO
  EXPORTACAO
  // Adicionados no Prompt 14 (Task Engine) — mesma técnica aditiva da
  // Sprint 08 (`ALTER TYPE ... ADD VALUE`). `COMENTARIO`/`ALTERACAO_STATUS`/
  // `ALTERACAO_RESPONSAVEL`/`ALTERACAO_PRIORIDADE`/`ARQUIVAMENTO`/
  // `RESTAURACAO` já eram genéricos o suficiente para reaproveitar sem
  // valor novo (Tarefa também os usa).
  CRIACAO_TAREFA
  CONCLUSAO_TAREFA
  CANCELAMENTO_TAREFA
  // Adicionados no módulo Colaboradores — mesma técnica aditiva das
  // extensões anteriores (`ALTER TYPE ... ADD VALUE`).
  COLABORADOR_CADASTRADO
  COLABORADOR_ATUALIZADO
  CARGO_ALTERADO
  GRUPO_ALTERADO
  ACESSO_CONCEDIDO
  ACESSO_REMOVIDO
  COLABORADOR_BLOQUEADO
  COLABORADOR_DESBLOQUEADO
  COLABORADOR_SUSPENSO
  COLABORADOR_REATIVADO
  CONVITE_ENVIADO
  CONVITE_REENVIADO
  PAPEL_ALTERADO
  PERMISSOES_ALTERADAS
  SESSOES_REVOGADAS
  COLABORADOR_INATIVADO
}

enum OrigemEvento {
  MANUAL
  SISTEMA
  IA
  IMPORTACAO
}

// Adicionado no Prompt 14 (Task Engine) — mesmo racional de `EscopoResumoIA`
// (Sprint 11): `EventoTimeline` deixa de ser exclusivo de `Processo`.
enum EscopoEventoTimeline {
  PROCESSO
  TAREFA
  // Adicionado no módulo Colaboradores.
  COLABORADOR
  PASTA_JURIDICA
}

model EventoTimeline {
  id                      String               @id @default(uuid()) @db.Uuid
  escritorioId            String               @map("escritorio_id") @db.Uuid
  escopoTipo              EscopoEventoTimeline @default(PROCESSO) @map("escopo_tipo")
  // Nullable desde o Prompt 14 — exatamente um entre `processoId`/`tarefaId`/
  // `membroId` é preenchido, de acordo com `escopoTipo` (mesmo padrão de
  // `ResumoIA`). `membroId` adicionado no módulo Colaboradores.
  processoId              String?              @map("processo_id") @db.Uuid
  tarefaId                String?              @map("tarefa_id") @db.Uuid
  membroId                String?              @map("membro_id") @db.Uuid
  pastaJuridicaId         String?              @map("pasta_juridica_id") @db.Uuid
  tipo                    TipoEventoTimeline
  titulo                  String
  descricao               String?
  dataEvento              DateTime             @map("data_evento") @db.Timestamptz
  dataRegistro            DateTime             @default(now()) @map("data_registro") @db.Timestamptz
  origem                  OrigemEvento         @default(MANUAL)
  autorId                 String?              @map("autor_id") @db.Uuid
  entidadeRelacionadaTipo String?              @map("entidade_relacionada_tipo")
  entidadeRelacionadaId   String?              @map("entidade_relacionada_id") @db.Uuid
  visibilidade            Visibilidade         @default(INTERNA)
  metadados               Json                 @default("{}")
  fixado                  Boolean              @default(false)
  criadoEm                DateTime             @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm            DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm              DateTime?            @map("excluido_em") @db.Timestamptz

  processo      Processo?      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tarefa        Tarefa?        @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  membro        Membro?        @relation(fields: [membroId], references: [id], onDelete: Cascade)
  pastaJuridica PastaJuridica? @relation(fields: [pastaJuridicaId], references: [id], onDelete: SetNull)

  comentarios Comentario[]
  fontesIa    FonteIA[]

  @@index([processoId, dataEvento(sort: Desc)], map: "idx_timeline_processo_data")
  @@index([processoId, tipo], map: "idx_timeline_processo_tipo")
  @@index([tarefaId, dataEvento(sort: Desc)], map: "idx_timeline_tarefa_data")
  @@index([membroId, dataEvento(sort: Desc)], map: "idx_timeline_membro_data")
  @@index([pastaJuridicaId, dataEvento(sort: Desc)], map: "idx_timeline_pasta_juridica_data")
  @@map("eventos_timeline")
}

