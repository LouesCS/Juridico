# Copie para .env e preencha com valores de desenvolvimento.
# NUNCA coloque segredo real de produção neste arquivo nem no .env versionado.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Postgres
DATABASE_URL=postgresql://quilombo:quilombo@localhost:5432/quilombo_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (RS256 — em desenvolvimento, gere um par local; nunca reutilize entre ambientes)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_KID=dev-key-1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_REFRESH_TTL_REMEMBER_SECONDS=2592000

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:3001

# OAuth (preencher em ambiente que for testar login social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# Storage (ver docs/backend/07-storage.md)
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_BUCKET=quilombo-dev-documents
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1
API_PUBLIC_URL=http://localhost:3000
LOCAL_STORAGE_DIR=./storage-data
LOCAL_STORAGE_SECRET=

# E-mail (ver docs/backend/02-modulos.md §2.17)
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_FROM=naoresponda@quilombodev.com.br
MAIL_SES_REGION=
MAIL_SENDGRID_API_KEY=

# IA (adapter — ver docs/backend/02-modulos.md e docs/05-arquitetura-backend.md §5.10)
# AI_PROVIDER=fake usa o MockAiProvider (real, determinístico, sem chamada externa).
AI_PROVIDER=fake
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_MONTHLY_QUOTA_TRIAL=20
AI_MONTHLY_QUOTA_ESSENCIAL=100
AI_MONTHLY_QUOTA_PROFISSIONAL=500

# Observabilidade
LOG_LEVEL=info
