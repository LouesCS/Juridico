# URL base da API (NestJS) — reafirma docs/frontend/08-http-client.md §8.2
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Domínio do storage assinado (usado só para permitir preview em iframe via CSP,
# ver next.config.ts) — vazio até o backend ter um StoragePort real.
NEXT_PUBLIC_STORAGE_URL=

# 'enabled' liga o MSW no navegador para os módulos ainda sem backend real
# (docs/frontend/28-mocks.md §28.1). Nunca 'enabled' em build de produção.
NEXT_PUBLIC_API_MOCKING=enabled
