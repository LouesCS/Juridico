  id              String      @id @default(uuid()) @db.Uuid
  escritorioId    String      @map("escritorio_id") @db.Uuid
  nome            String
  data            DateTime    @db.Date
  tipo            TipoFeriado @default(PERSONALIZADO)
  uf              String?     @db.VarChar(2)
  recorrenteAnual Boolean     @default(false) @map("recorrente_anual")
  ativo           Boolean     @default(true)
  criadoEm        DateTime    @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm    DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm      DateTime?   @map("excluido_em") @db.Timestamptz

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@unique([escritorioId, nome, data], map: "uq_feriados_escritorio_nome_data")
  @@index([escritorioId, data], map: "idx_feriados_escritorio_data")
  @@map("feriados")
}

// ============================================================================
// TASK ENGINE (Prompt 14, docs/backend-implementation/23-task-engine.md)
//
// Status/Prioridade NUNCA são enum fixo — apontam para itens de
// `ConjuntoValores`/`ConjuntoValorItem` (Configuration Engine, Prompt 13),
// auto-provisionados por escritório na primeira tarefa criada. Categoria/
// Modelo reaproveitam `CategoriaTarefa`/`ModeloTarefa` (mesmo Prompt 13),
// nunca duplicados. Toda referência cross-módulo (categoria, modelo,
// status, prioridade, responsável, equipe, grupo de colaboradores) é
// coluna solta, validada na aplicação — mesmo desacoplamento que
// `Processo.responsavelPrincipalId`/`ProcessoMembro.membroId` já usam
// (nenhuma FK de banco para `Membro`/`Equipe`/`ConjuntoValorItem` a
// partir daqui). Referências dentro do próprio módulo de Timeline/
// Comentários/IA (já generalizados para Tarefa acima, mesma técnica do
// Sprint 11) e dentro do próprio Task Engine usam relação real do Prisma.
// ============================================================================

enum TipoVinculoTarefa {
  CLIENTE
  PROCESSO
  DOCUMENTO
  // Catálogo-pronto — módulos de negócio ainda não implementados (mesmo
  // tratamento de `financeiro:*` no Prompt 12): a tabela aceita o vínculo,
  // mas nenhuma tela resolve o recurso além de Cliente/Processo/Documento.
  CONTRATO
  SERVICO
  FINANCEIRO
  PUBLICACAO
  PEDIDO
  REGISTRO_TRABALHO
  PASTA_JURIDICA
  MOVIMENTACAO_EXTRAJUDICIAL
  MOVIMENTACAO_JUDICIAL
}

enum FrequenciaRecorrencia {
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
  DIAS_UTEIS
  DIAS_ESPECIFICOS
}

model TarefaRecorrencia {
  id                 String                @id @default(uuid()) @db.Uuid
  escritorioId       String                @map("escritorio_id") @db.Uuid
  frequencia         FrequenciaRecorrencia
  intervalo          Int                   @default(1)
  /// Só usado quando `frequencia = DIAS_ESPECIFICOS` — 0 (domingo) a 6 (sábado).
  diasSemana         Int[]                 @default([])
  respeitarDiasUteis Boolean               @default(false) @map("respeitar_dias_uteis")
  dataFim            DateTime?             @map("data_fim") @db.Date
  criadoEm           DateTime              @default(now()) @map("criado_em") @db.Timestamptz

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  tarefas    Tarefa[]

  @@map("tarefa_recorrencias")
}

model Tarefa {
  id                     String    @id @default(uuid()) @db.Uuid
  escritorioId           String    @map("escritorio_id") @db.Uuid
  titulo                 String
  descricao              String?
  categoriaId            String?   @map("categoria_id") @db.Uuid
  statusId               String?   @map("status_id") @db.Uuid
  prioridadeId           String?   @map("prioridade_id") @db.Uuid
  modeloOrigemId         String?   @map("modelo_origem_id") @db.Uuid
  responsavelPrincipalId String?   @map("responsavel_principal_id") @db.Uuid
  equipeId               String?   @map("equipe_id") @db.Uuid
  grupoColaboradoresId   String?   @map("grupo_colaboradores_id") @db.Uuid
  dataInicio             DateTime? @map("data_inicio") @db.Date
  dataVencimento         DateTime? @map("data_vencimento") @db.Date
  recorrenciaId          String?   @map("recorrencia_id") @db.Uuid
  tarefaOrigemId         String?   @map("tarefa_origem_id") @db.Uuid
  criadoPorId            String    @map("criado_por_id") @db.Uuid
  concluidaEm            DateTime? @map("concluida_em") @db.Timestamptz
  canceladaEm            DateTime? @map("cancelada_em") @db.Timestamptz
  motivoCancelamento     String?   @map("motivo_cancelamento")
  arquivadaEm            DateTime? @map("arquivada_em") @db.Timestamptz
  criadoEm               DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm           DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm             DateTime? @map("excluido_em") @db.Timestamptz

  escritorio   Escritorio         @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  recorrencia  TarefaRecorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)
  tarefaOrigem Tarefa?            @relation("TarefaRecorrenteOrigem", fields: [tarefaOrigemId], references: [id], onDelete: SetNull)

  instanciasRecorrentes  Tarefa[]                    @relation("TarefaRecorrenteOrigem")
  checklist              TarefaChecklistItem[]
  responsaveisAuxiliares TarefaResponsavelAuxiliar[]
  vinculos               TarefaVinculo[]
  favoritos              TarefaFavorito[]
  dependencias           TarefaDependencia[]         @relation("TarefaDependeDe")
  bloqueando             TarefaDependencia[]         @relation("TarefaDependenciaDe")
  eventosTimeline        EventoTimeline[]
  comentarios            Comentario[]
  resumosIa              ResumoIA[]
  fontesIa               FonteIA[]

  @@index([escritorioId, responsavelPrincipalId], map: "idx_tarefas_escritorio_responsavel")
  @@index([escritorioId, dataVencimento], map: "idx_tarefas_escritorio_vencimento")
  @@index([escritorioId, statusId], map: "idx_tarefas_escritorio_status")
  @@index([escritorioId, categoriaId], map: "idx_tarefas_escritorio_categoria")
  @@index([escritorioId, equipeId], map: "idx_tarefas_escritorio_equipe")
  @@map("tarefas")
}

model TarefaChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  tarefaId       String    @map("tarefa_id") @db.Uuid
  titulo         String
  obrigatorio    Boolean   @default(false)
  ordem          Int       @default(0)
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamptz
  concluidoPorId String?   @map("concluido_por_id") @db.Uuid
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId, ordem], map: "idx_tarefa_checklist_tarefa")
  @@map("tarefa_checklist_itens")
}

model TarefaResponsavelAuxiliar {
  id       String @id @default(uuid()) @db.Uuid
  tarefaId String @map("tarefa_id") @db.Uuid
  membroId String @map("membro_id") @db.Uuid

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, membroId], map: "uq_tarefa_responsavel_auxiliar")
  @@map("tarefa_responsaveis_auxiliares")
}

/// `tarefa`/`tarefaId` = a tarefa dependente (bloqueada); `dependeDe`/
/// `dependeDeId` = o pré-requisito (precisa concluir primeiro).
model TarefaDependencia {
  id          String   @id @default(uuid()) @db.Uuid
  tarefaId    String   @map("tarefa_id") @db.Uuid
  dependeDeId String   @map("depende_de_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  tarefa    Tarefa @relation("TarefaDependeDe", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDe Tarefa @relation("TarefaDependenciaDe", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, dependeDeId], map: "uq_tarefa_dependencia")
  @@map("tarefa_dependencias")
}

model TarefaVinculo {
  id          String            @id @default(uuid()) @db.Uuid
  tarefaId    String            @map("tarefa_id") @db.Uuid
  tipoRecurso TipoVinculoTarefa @map("tipo_recurso")
  recursoId   String            @map("recurso_id") @db.Uuid
  criadoEm    DateTime          @default(now()) @map("criado_em") @db.Timestamptz

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, tipoRecurso, recursoId], map: "uq_tarefa_vinculo")
  @@index([tipoRecurso, recursoId], map: "idx_tarefa_vinculo_recurso")
  @@map("tarefa_vinculos")
}

model TarefaFavorito {
  tarefaId String   @map("tarefa_id") @db.Uuid
  membroId String   @map("membro_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  tarefa Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@id([tarefaId, membroId])
  @@map("tarefa_favorito")
}
