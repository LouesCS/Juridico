enum StorageProvider {
  S3
  LOCAL
}

enum StatusUpload {
  PENDENTE
  CONCLUIDO
  FALHA
}

enum StatusProcessamentoDocumento {
  PENDENTE
  PROCESSANDO
  PRONTO
  FALHA
}

enum StatusAntivirus {
  PENDENTE
  LIMPO
  INFECTADO
  ERRO
}

enum TipoDocumento {
  PETICAO
  CONTRATO
  PROCURACAO
  SENTENCA
  DECISAO
  COMPROVANTE
  PARECER
  OUTRO
}

enum NivelConfidencialidade {
  PADRAO
  CONFIDENCIAL
}

enum Visibilidade {
  INTERNA
  COMPARTILHADA
  PUBLICA
}

model Pasta {
  id           String    @id @default(uuid()) @db.Uuid
  escritorioId String    @map("escritorio_id") @db.Uuid
  processoId   String?   @map("processo_id") @db.Uuid
  pastaPaiId   String?   @map("pasta_pai_id") @db.Uuid
  nome         String
  ordem        Int       @default(0)
  criadaPorId  String    @map("criada_por_id") @db.Uuid
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm   DateTime? @map("excluido_em") @db.Timestamptz

  processo                    Processo?                   @relation(fields: [processoId], references: [id], onDelete: Cascade)
  pastaPai                    Pasta?                      @relation("PastaHierarquia", fields: [pastaPaiId], references: [id], onDelete: Restrict)
  subpastas                   Pasta[]                     @relation("PastaHierarquia")
  documentos                  Documento[]
  favoritos                   PastaFavorito[]
  movimentacoesExtrajudiciais MovimentacaoExtrajudicial[]

  @@index([processoId], map: "idx_pastas_processo")
  @@index([pastaPaiId], map: "idx_pastas_pai")
  @@map("pastas")
}

// Adicionado na Sprint 09 (Documentos e Pastas) — "favoritar" é por membro,
// não uma coluna global no agregado (dois membros do mesmo escritório podem
// favoritar pastas diferentes), mesmo racional de `DocumentoFavorito` abaixo.
model PastaFavorito {
  pastaId  String   @map("pasta_id") @db.Uuid
  membroId String   @map("membro_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  pasta Pasta @relation(fields: [pastaId], references: [id], onDelete: Cascade)

  @@id([pastaId, membroId])
  @@map("pasta_favorito")
}

model Documento {
  id                  String                       @id @default(uuid()) @db.Uuid
  escritorioId        String                       @map("escritorio_id") @db.Uuid
  processoId          String?                      @map("processo_id") @db.Uuid
  clienteId           String?                      @map("cliente_id") @db.Uuid
  pastaId             String?                      @map("pasta_id") @db.Uuid
  nome                String
  nomeOriginal        String                       @map("nome_original")
  extensao            String
  mimeType            String                       @map("mime_type")
  tamanhoBytes        BigInt                       @map("tamanho_bytes")
  storageProvider     StorageProvider              @default(S3) @map("storage_provider")
  storageKey          String                       @map("storage_key")
  // Nullable desde a Sprint 09 — achado real: `POST /v1/documents/presign`
  // (docs/api/10-documents.md §10.3) cria a linha ANTES do hash existir (o
  // cliente só calcula o hash depois de ler o binário, no passo de
  // `confirm`); `hashSha256 NOT NULL` original era impossível de satisfazer
  // honestamente nesta janela. Passa a ser preenchido apenas em
  // `ConfirmDocumentUploadUseCase`/`ConfirmDocumentVersionUseCase`.
  hashSha256          String?                      @map("hash_sha256")
  statusUpload        StatusUpload                 @default(PENDENTE) @map("status_upload")
  statusProcessamento StatusProcessamentoDocumento @default(PENDENTE) @map("status_processamento")
  statusAntivirus     StatusAntivirus              @default(PENDENTE) @map("status_antivirus")
  categoria           String?
  tipo                TipoDocumento                @default(OUTRO)
  confidencialidade   NivelConfidencialidade       @default(PADRAO)
  visibilidade        Visibilidade                 @default(INTERNA)
  descricao           String?
  versaoVigenteId     String?                      @map("versao_vigente_id") @db.Uuid
  autorUploadId       String                       @map("autor_upload_id") @db.Uuid
  dataDocumento       DateTime?                    @map("data_documento") @db.Date
  versao              Int                          @default(1)
  criadoEm            DateTime                     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm        DateTime                     @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm          DateTime?                    @map("excluido_em") @db.Timestamptz
  // Ver nota em Cliente.buscaTsv.
  buscaTsv            Unsupported("tsvector")?     @map("busca_tsv")

  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  pasta    Pasta?    @relation(fields: [pastaId], references: [id], onDelete: SetNull)

  versoes     VersaoDocumento[]
  comentarios Comentario[]
  tags        DocumentoTag[]
  fontesIa    FonteIA[]
  // Adicionado na Sprint 11 — "Resumir Documento".
  resumosIa   ResumoIA[]
  favoritos   DocumentoFavorito[]
  vinculos    DocumentoVinculo[]

  @@index([escritorioId, processoId], map: "idx_documentos_escritorio_processo")
  @@index([pastaId], map: "idx_documentos_pasta")
  @@index([escritorioId, hashSha256], map: "idx_documentos_hash")
  @@map("documentos")
}

enum TipoVinculoDocumento {
  PASTA_JURIDICA
}

/// Vínculo contextual genérico do Document Engine. Não representa a Pasta
/// documental (`Pasta`) e não duplica o arquivo.
model DocumentoVinculo {
  id           String               @id @default(uuid()) @db.Uuid
  escritorioId String               @map("escritorio_id") @db.Uuid
  documentoId  String               @map("documento_id") @db.Uuid
  tipoRecurso  TipoVinculoDocumento @map("tipo_recurso")
  recursoId    String               @map("recurso_id") @db.Uuid
  criadoPorId  String               @map("criado_por_id") @db.Uuid
  criadoEm     DateTime             @default(now()) @map("criado_em") @db.Timestamptz

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, tipoRecurso, recursoId], map: "uq_documento_vinculo_recurso")
  @@index([escritorioId, tipoRecurso, recursoId, criadoEm], map: "idx_documento_vinculo_contexto")
  @@map("documento_vinculo")
}

// Adicionado na Sprint 09 (Documentos e Pastas) — favorito é por membro
// (Google Drive/Notion: cada usuário tem sua própria lista), não uma coluna
// booleana única no Documento (que seria global ao escritório inteiro).
model DocumentoFavorito {
  documentoId String   @map("documento_id") @db.Uuid
  membroId    String   @map("membro_id") @db.Uuid
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@id([documentoId, membroId])
  @@map("documento_favorito")
}

model VersaoDocumento {
  id               String   @id @default(uuid()) @db.Uuid
  documentoId      String   @map("documento_id") @db.Uuid
  numero           Int
  storageKey       String   @map("storage_key")
  hashSha256       String   @map("hash_sha256")
  tamanhoBytes     BigInt   @map("tamanho_bytes")
  autorId          String   @map("autor_id") @db.Uuid
  comentarioVersao String?  @map("comentario_versao")
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz

  documento Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, numero], map: "uq_versoes_documento_numero")
  @@map("versoes_documento")
}

