  LEITURA_ESCRITA
}

enum TipoRelacaoProcesso {
  PRINCIPAL
  DEPENDENTE
  RECURSO
  CUMPRIMENTO
  CONEXO
  APENSO
  RELACIONADO
}

enum TipoPrazo {
  FATAL
  INTERNO
  AUDIENCIA
  REUNIAO
  TAREFA
}

enum PrioridadePrazo {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusPrazo {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  ATRASADO
}

enum OrigemPrazo {
  MANUAL
  IMPORTADO
  IA
  TRIBUNAL
}

model Processo {
  id                      String                   @id @default(uuid()) @db.Uuid
  escritorioId            String                   @map("escritorio_id") @db.Uuid
  clienteId               String                   @map("cliente_id") @db.Uuid
  numeroCnj               String?                  @map("numero_cnj")
  numeroInterno           String?                  @map("numero_interno")
  instituicao             String?
  numeroBeneficio         String?                  @map("numero_beneficio")
  /// RO - Número do Benefício (campo específico do Judicial previdenciário
  /// — sem equivalente existente no domínio; ver migration
  /// 20260813010000_judicial_case_fields).
  roNumeroBeneficio       String?                  @map("ro_numero_beneficio")
  titulo                  String
  descricao               String?
  area                    String
  tipoAcao                String?                  @map("tipo_acao")
  tipo                    TipoProcesso             @default(JUDICIAL)
  tribunal                String?
  comarca                 String?
  vara                    String?
  uf                      String?                  @db.Char(2)
  instancia               InstanciaProcesso?
  classeProcessual        String?                  @map("classe_processual")
  assunto                 String?
  poloCliente             PoloProcesso             @map("polo_cliente")
  status                  StatusProcesso           @default(ATIVO)
  prioridade              PrioridadeProcesso       @default(MEDIA)
  segredoJustica          Boolean                  @default(false) @map("segredo_justica")
  valorCausaCentavos      BigInt?                  @map("valor_causa_centavos")
  moedaValorCausa         String                   @default("BRL") @map("moeda_valor_causa") @db.Char(3)
  dataDistribuicao        DateTime?                @map("data_distribuicao") @db.Date
  dataEncerramento        DateTime?                @map("data_encerramento") @db.Date
  responsavelPrincipalId  String                   @map("responsavel_principal_id") @db.Uuid
  proximaDataRelevante    DateTime?                @map("proxima_data_relevante") @db.Timestamptz
  observacoes             String?
  camposCustomizados      Json                     @default("{}") @map("campos_customizados")
  resumoIaVigenteId       String?                  @map("resumo_ia_vigente_id") @db.Uuid
  ultimaAtualizacaoEm     DateTime                 @default(now()) @map("ultima_atualizacao_em") @db.Timestamptz
  versao                  Int                      @default(1)
  criadoEm                DateTime                 @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm            DateTime                 @updatedAt @map("atualizado_em") @db.Timestamptz
  arquivadoEm             DateTime?                @map("arquivado_em") @db.Timestamptz
  excluidoEm              DateTime?                @map("excluido_em") @db.Timestamptz
  // Colunas geradas — ver nota em Cliente.buscaTsv; definidas de fato em
  // prisma/migrations/20260731000002_search_extensions.
  buscaTsv                Unsupported("tsvector")? @map("busca_tsv")
  // GENERATED ALWAYS no banco (regexp_replace de numero_cnj) — declarado
  // como String normal porque o Prisma lida bem com o tipo `text`, mas a
  // aplicação nunca deve escrever neste campo (o Postgres rejeitaria a
  // escrita com erro, nunca corrompe dado silenciosamente).
  numeroCnjSomenteDigitos String?                  @map("numero_cnj_somente_digitos")

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Restrict)
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  partes                      ParteProcesso[]
  equipe                      ProcessoMembro[]
  prazos                      Prazo[]
  eventosTimeline             EventoTimeline[]
  documentos                  Documento[]
  pastas                      Pasta[]
  comentarios                 Comentario[]
  resumosIa                   ResumoIA[]
  // Adicionado na Sprint 11 — citar o processo como fonte de um Histórico de Cliente.
  fontesIa                    FonteIA[]
  tags                        ProcessoTag[]
  relacionadosOrigem          ProcessoRelacionado[]         @relation("ProcessoOrigem")
  relacionadosDestino         ProcessoRelacionado[]         @relation("ProcessoRelacionadoRel")
  configuracoesCaptura        ConfiguracaoCaptura[]
  movimentosCapturados        MovimentoJudicialCapturado[]
  publicacoesCapturadas       PublicacaoJudicialCapturada[]
  movimentacoesExtrajudiciais MovimentacaoExtrajudicial[]
  pastasJuridicas             PastaJuridicaProcesso[]
  pedidos                     Pedido[]

  @@unique([escritorioId, numeroCnj], map: "uq_processos_escritorio_cnj")
  @@index([escritorioId, status], map: "idx_processos_escritorio_status")
  @@index([escritorioId, responsavelPrincipalId], map: "idx_processos_escritorio_responsavel")
  @@index([escritorioId, ultimaAtualizacaoEm(sort: Desc)], map: "idx_processos_escritorio_atualizacao")
  @@index([clienteId], map: "idx_processos_cliente")
  @@map("processos")
}

