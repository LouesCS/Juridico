/// Dossiê jurídico operacional. Não confundir com `Pasta`, que é Folder do
/// Document Engine e existe apenas para organizar arquivos.
model PastaJuridica {
  id                        String    @id @default(uuid()) @db.Uuid
  escritorioId              String    @map("escritorio_id") @db.Uuid
  nome                      String
  prefixo                   String?
  sequencial                Int?
  numeroInterno             String?   @map("numero_interno")
  assunto                   String?
  categoria                 String?
  etapa                     String?
  situacao                  String    @default("EM_ANDAMENTO")
  confidencial              Boolean   @default(false)
  clientePrincipalId        String    @map("cliente_principal_id") @db.Uuid
  parteContrariaPrincipalId String?   @map("parte_contraria_principal_id") @db.Uuid
  encarregadoId             String    @map("encarregado_id") @db.Uuid
  observacoes               String?
  camposExtrasValores       Json      @default("{}") @map("campos_extras_valores")
  dataConclusao             DateTime? @map("data_conclusao") @db.Date
  criadoEm                  DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz
  arquivadoEm               DateTime? @map("arquivado_em") @db.Timestamptz
  excluidoEm                DateTime? @map("excluido_em") @db.Timestamptz

  escritorio                  Escritorio                  @relation(fields: [escritorioId], references: [id], onDelete: Restrict)
  clientePrincipal            Cliente                     @relation("PastaJuridicaClientePrincipal", fields: [clientePrincipalId], references: [id], onDelete: Restrict)
  parteContrariaPrincipal     Cliente?                    @relation("PastaJuridicaParteContraria", fields: [parteContrariaPrincipalId], references: [id], onDelete: SetNull)
  processos                   PastaJuridicaProcesso[]
  vinculosClientes            PastaJuridicaCliente[]
  configuracoesCaptura        ConfiguracaoCaptura[]
  movimentacoesExtrajudiciais MovimentacaoExtrajudicial[]
  eventosTimeline             EventoTimeline[]
  pedidos                     Pedido[]
  publicacoes                 PublicacaoJudicialCapturada[]

  @@unique([escritorioId, numeroInterno], map: "uq_pastas_juridicas_escritorio_numero")
  @@unique([escritorioId, prefixo, sequencial], map: "uq_pastas_juridicas_escritorio_prefixo_sequencial")
  @@index([escritorioId, situacao], map: "idx_pastas_juridicas_escritorio_situacao")
  @@index([escritorioId, clientePrincipalId], map: "idx_pastas_juridicas_cliente")
  @@index([escritorioId, encarregadoId], map: "idx_pastas_juridicas_encarregado")
  @@map("pastas_juridicas")
}

