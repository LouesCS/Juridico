  TERCEIRO
}

enum StatusProcesso {
  ATIVO
  SUSPENSO
  ARQUIVADO
  ENCERRADO
}

enum PrioridadeProcesso {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum TipoParticipante {
  AUTOR
  REU
  TERCEIRO_INTERESSADO
  ASSISTENTE
  MINISTERIO_PUBLICO
  TESTEMUNHA
  PERITO
  ADVOGADO_EXTERNO
  /// Advogado que representa o polo Autor — distinto de ADVOGADO_EXTERNO
  /// (que não carrega polo) para permitir "advogado principal do polo"
  /// reutilizando o mesmo mecanismo de ParteProcesso.principal + índice
  /// único parcial já usado por AUTOR/REU.
  ADVOGADO_AUTOR
  /// Advogado que representa o polo Réu — ver ADVOGADO_AUTOR.
  ADVOGADO_REU
  JUIZ
  PROMOTOR
  REPRESENTANTE_LEGAL
  OUTRO
}

