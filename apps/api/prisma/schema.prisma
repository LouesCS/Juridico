// Quilombo Dev — schema.prisma (Fase 1)
//
// Implementa integralmente a modelagem oficial de docs/database/03 a 06.
// Convenções: docs/database/02-convencoes-dados.md (snake_case no banco via
// @map/@@map, camelCase no Prisma, UUID, soft delete, versionamento otimista).
//
// PROMPT 5C Etapa 2/3 (docs/backend-implementation/03-multitenancy.md,
// 02-database.md): RLS, extensões pg_trgm/unaccent e as colunas tsvector
// geradas (`buscaTsv`, declaradas abaixo como Unsupported("tsvector") só
// para o Prisma não tentar removê-las por drift) já têm migration SQL
// manual escrita em prisma/migrations/20260731000001_enable_rls e
// prisma/migrations/20260731000002_search_extensions — NUNCA EXECUTADA
// contra Postgres real neste ambiente (sem Docker/Postgres disponível).
//
// O que este arquivo/estas migrations ainda NÃO representam:
//   - Roles de banco reais (app_runtime/app_migration) — a migration de RLS
//     assume que `app_runtime` existe, mas não a cria (isso é provisionamento
//     de infraestrutura, fora do escopo de uma migration de schema)
//   - Particionamento de log_auditoria por mês
//   - Triggers de normalização de e-mail
//   - `documentos.texto_extraido` (citado em docs/database/09 §9.3, nunca
//     modelado como coluna na Fase 1 implementada — ver nota na migration
//     20260731000002_search_extensions)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY
// ============================================================================

enum TemaUsuario {
  CLARO
  ESCURO
  SISTEMA
}

enum StatusUsuario {
  PENDENTE
  ATIVO
  INATIVO
  BLOQUEADO
}

enum ProvedorAuth {
  LOCAL
  GOOGLE
  MICROSOFT
  SAML
}

enum MotivoRevogacaoSessao {
  LOGOUT
  TROCA_SENHA
  REUSO_DETECTADO
  ADMIN
  EXPIRACAO
}

model Usuario {
  id                String        @id @default(uuid()) @db.Uuid
  nome              String
  sobrenome         String
  email             String
  emailVerificadoEm DateTime?     @map("email_verificado_em") @db.Timestamptz
  senhaHash         String?       @map("senha_hash")
  avatarUrl         String?       @map("avatar_url")
  telefone          String?
  idioma            String        @default("pt-BR")
  fusoHorario       String        @default("America/Sao_Paulo") @map("fuso_horario")
  tema              TemaUsuario   @default(SISTEMA)
  status            StatusUsuario @default(PENDENTE)
  mfaHabilitado     Boolean       @default(false) @map("mfa_habilitado")
  mfaSegredo        String?       @map("mfa_segredo")
  ultimoAcessoEm    DateTime?     @map("ultimo_acesso_em") @db.Timestamptz
  criadoEm          DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm      DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm        DateTime?     @map("excluido_em") @db.Timestamptz

  identidades UserIdentity[]
  sessoes     Sessao[]
  membros     Membro[]

  @@unique([email], map: "uq_usuarios_email")
  @@map("usuarios")
}

model UserIdentity {
  id                        String       @id @default(uuid()) @db.Uuid
  usuarioId                 String       @map("usuario_id") @db.Uuid
  provider                  ProvedorAuth
  providerAccountId         String?      @map("provider_account_id")
  emailNoProvedor           String?      @map("email_no_provedor")
  emailVerificadoNoProvedor Boolean      @default(false) @map("email_verificado_no_provedor")
  accessTokenCriptografado  Bytes?       @map("access_token_criptografado")
  refreshTokenCriptografado Bytes?       @map("refresh_token_criptografado")
  escopos                   String[]     @default([])
  expiraEm                  DateTime?    @map("expira_em") @db.Timestamptz
  criadoEm                  DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm              DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "uq_user_identity_provider_account")
  @@index([usuarioId], map: "idx_user_identity_usuario")
  @@map("user_identities")
}

model TokenRecuperacaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamptz

  @@unique([tokenHash], map: "uq_token_recuperacao_senha")
  @@index([usuarioId], map: "idx_token_recuperacao_usuario")
  @@map("tokens_recuperacao_senha")
}

model Sessao {
  id                String                 @id @default(uuid()) @db.Uuid
  usuarioId         String                 @map("usuario_id") @db.Uuid
  escritorioAtivoId String                 @map("escritorio_ativo_id") @db.Uuid
  familiaId         String                 @map("familia_id") @db.Uuid
  refreshTokenHash  String                 @map("refresh_token_hash")
  ip                String?
  userAgent         String?                @map("user_agent")
  dispositivo       String?
  criadaEm          DateTime               @default(now()) @map("criada_em") @db.Timestamptz
  ultimoUsoEm       DateTime               @default(now()) @map("ultimo_uso_em") @db.Timestamptz
  expiraEm          DateTime               @map("expira_em") @db.Timestamptz
  revogadaEm        DateTime?              @map("revogada_em") @db.Timestamptz
  motivoRevogacao   MotivoRevogacaoSessao? @map("motivo_revogacao")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  escritorio Escritorio @relation(fields: [escritorioAtivoId], references: [id], onDelete: Restrict)

  @@index([usuarioId], map: "idx_sessoes_usuario")
  @@index([familiaId], map: "idx_sessoes_familia")
  @@map("sessoes")
}

// ============================================================================
// OFFICES
// ============================================================================

enum StatusEscritorio {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
}

enum PlanoEscritorio {
  TRIAL
  ESSENCIAL
  PROFISSIONAL
  ENTERPRISE
}

model Escritorio {
  id                  String           @id @default(uuid()) @db.Uuid
  razaoSocial         String?          @map("razao_social")
  nomeFantasia        String           @map("nome_fantasia")
  slug                String
  cnpj                String?
  email               String
  telefone            String?
  enderecoLogradouro  String?          @map("endereco_logradouro")
  enderecoNumero      String?          @map("endereco_numero")
  enderecoComplemento String?          @map("endereco_complemento")
  enderecoBairro      String?          @map("endereco_bairro")
  enderecoCidade      String?          @map("endereco_cidade")
  enderecoUf          String?          @map("endereco_uf") @db.Char(2)
  enderecoCep         String?          @map("endereco_cep")
  fusoHorario         String           @default("America/Sao_Paulo") @map("fuso_horario")
  idioma              String           @default("pt-BR")
  status              StatusEscritorio @default(TRIAL)
  plano               PlanoEscritorio  @default(TRIAL)
  configuracoes       Json             @default("{}")
  criadoEm            DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm        DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm          DateTime?        @map("excluido_em") @db.Timestamptz

  sessoes                     Sessao[]
  membros                     Membro[]
  convites                    Convite[]
  papeis                      Papel[]
  equipes                     Equipe[]
  clientes                    Cliente[]
  processos                   Processo[]
  configuracoesCaptura        ConfiguracaoCaptura[]
  historicosCaptura           HistoricoSincronizacaoCaptura[]
  movimentosCapturados        MovimentoJudicialCapturado[]
  movimentacoesExtrajudiciais MovimentacaoExtrajudicial[]
  publicacoesCapturadas       PublicacaoJudicialCapturada[]
  pastasJuridicas             PastaJuridica[]
  prefixosPastasJuridicas     PrefixoPastaJuridica[]
  opcoesPastasJuridicas       OpcaoPastaJuridica[]
  pedidos                     Pedido[]

  camposExtra         CampoExtra[]
  camposObrigatorios  CampoObrigatorio[]
  conjuntosValores    ConjuntoValores[]
  categoriasTarefa    CategoriaTarefa[]
  gruposColaboradores GrupoColaboradores[]
  cargos              Cargo[]
  modelosTarefa       ModeloTarefa[]
  feriados            Feriado[]

  tarefas            Tarefa[]
  tarefaRecorrencias TarefaRecorrencia[]

  @@unique([slug], map: "uq_escritorios_slug")
  @@map("escritorios")
}

// ============================================================================
// MEMBERSHIPS
// ============================================================================

enum StatusMembro {
  ATIVO
  INATIVO
  SUSPENSO
}

enum StatusConvite {
  PENDENTE
  ACEITO
  EXPIRADO
  REVOGADO
}

enum EscopoPermissao {
  ALL
  TEAM
  ASSIGNED
  OWN
}

enum EfeitoPermissao {
  CONCEDER
  NEGAR
}

model Papel {
  id           String   @id @default(uuid()) @db.Uuid
  escritorioId String?  @map("escritorio_id") @db.Uuid
  nome         String
  descricao    String?
  nivel        Int
  ehSistema    Boolean  @default(false) @map("eh_sistema")
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  escritorio Escritorio?      @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  membros    Membro[]
  permissoes PapelPermissao[]

  @@index([escritorioId], map: "idx_papeis_escritorio")
  @@map("papeis")
}

model Permissao {
  id        String          @id @default(uuid()) @db.Uuid
  chave     String
  recurso   String
  acao      String
  escopo    EscopoPermissao
  categoria String
  descricao String

  papeis          PapelPermissao[]
  overridesMembro PermissaoUsuario[]

  @@unique([chave], map: "uq_permissoes_chave")
  @@map("permissoes")
}

model PapelPermissao {
  papelId     String @map("papel_id") @db.Uuid
  permissaoId String @map("permissao_id") @db.Uuid

  papel     Papel     @relation(fields: [papelId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([papelId, permissaoId])
  @@map("papel_permissao")
}

model Equipe {
  id           String   @id @default(uuid()) @db.Uuid
  escritorioId String   @map("escritorio_id") @db.Uuid
  nome         String
  liderId      String?  @map("lider_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz

  escritorio Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  membros    Membro[]

  @@map("equipes")
}

model Membro {
  id           String  @id @default(uuid()) @db.Uuid
  // Nullable a partir do módulo Colaboradores — um colaborador pode ser
  // cadastrado sem nunca ganhar acesso ao sistema (nenhuma conta `Usuario`
  // vinculada). Quando o acesso é concedido e o convite aceito,
  // `AcceptInvitationUseCase` preenche este campo (cria ou reaproveita um
  // `Usuario` pelo e-mail) — nunca o contrário.
  usuarioId    String? @map("usuario_id") @db.Uuid
  escritorioId String  @map("escritorio_id") @db.Uuid
  papelId      String  @map("papel_id") @db.Uuid
  equipeId     String? @map("equipe_id") @db.Uuid

  // Identidade do colaborador — fonte canônica para o módulo Colaboradores,
  // preenchida independentemente de haver conta de acesso. Para membros já
  // existentes (pré-módulo Colaboradores), a migration faz backfill a partir
  // de `usuario.nome`/`usuario.email`. Quando o acesso é concedido, o
  // `Usuario` criado/vinculado recebe estes mesmos valores — evita duas
  // fontes de verdade divergentes para quem já tem login.
  nome           String
  email          String
  nomeSocial     String?      @map("nome_social")
  cpf            String?
  rg             String?
  dataNascimento DateTime?    @map("data_nascimento") @db.Date
  estadoCivil    EstadoCivil? @map("estado_civil")
  profissao      String?
  nomeMae        String?      @map("nome_mae")
  nomePai        String?      @map("nome_pai")
  anotacoes      String?      @db.Text
  fotoUrl        String?      @map("foto_url")

  // Contato — campos únicos (não array como em `Cliente.emails`/`telefones`):
  // `email` acima tem papel funcional (e-mail de convite/login quando o
  // acesso é concedido), não apenas informativo.
  telefone String?
  celular  String?
  whatsapp String?

  // Endereço — mesmos nomes/prefixo de `Cliente` (`enderecoUf`, não
  // `enderecoEstado`) por consistência entre os dois cadastros de pessoa.
  enderecoLogradouro  String? @map("endereco_logradouro")
  enderecoNumero      String? @map("endereco_numero")
  enderecoComplemento String? @map("endereco_complemento")
  enderecoBairro      String? @map("endereco_bairro")
  enderecoCidade      String? @map("endereco_cidade")
  enderecoUf          String? @map("endereco_uf") @db.Char(2)
  enderecoCep         String? @map("endereco_cep")
  enderecoPais        String? @map("endereco_pais")

  // Dados profissionais. `cargo` (texto livre) é o campo legado, mantido só
  // para leitura de registros antigos — `cargoId` (catálogo `Cargo`,
  // Configuration Engine) é o campo ativo a partir do módulo Colaboradores.
  cargo         String?
  cargoId       String?   @map("cargo_id") @db.Uuid
  departamento  String?
  numeroOab     String?   @map("numero_oab")
  ufOab         String?   @map("uf_oab") @db.Char(2)
  situacaoOab   String?   @map("situacao_oab")
  observacaoOab String?   @map("observacao_oab")
  dataEntrada   DateTime? @map("data_entrada") @db.Date
  responsavelId String?   @map("responsavel_id") @db.Uuid

  status                   StatusMembro @default(ATIVO)
  entrouEm                 DateTime     @default(now()) @map("entrou_em") @db.Timestamptz
  convidadoPorId           String?      @map("convidado_por_id") @db.Uuid
  dataAceiteConvite        DateTime?    @map("data_aceite_convite") @db.Timestamptz
  configuracoesEspecificas Json         @default("{}") @map("configuracoes_especificas")
  desativadoEm             DateTime?    @map("desativado_em") @db.Timestamptz
  desativadoPorId          String?      @map("desativado_por_id") @db.Uuid
  criadoEm                 DateTime     @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm             DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz

  usuario       Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  escritorio    Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Restrict)
  papel         Papel      @relation(fields: [papelId], references: [id], onDelete: Restrict)
  equipe        Equipe?    @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  cargoCatalogo Cargo?     @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  responsavel   Membro?    @relation("MembroResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  permissoesOverride                     PermissaoUsuario[]
  convitesEmitidos                       Convite[]                                @relation("ConvitesEmitidosPeloMembro")
  convitesRecebidos                      Convite[]                                @relation("ConviteParaMembro")
  gruposColaboradores                    GrupoColaboradorMembro[]
  subordinados                           Membro[]                                 @relation("MembroResponsavel")
  eventosTimeline                        EventoTimeline[]
  estadosPublicacao                      PublicacaoEstadoUsuario[]
  estadosMovimento                       MovimentoEstadoUsuario[]
  movimentacoesExtrajudiciaisResponsavel MovimentacaoExtrajudicial[]              @relation("MovimentacaoExtrajudicialResponsavel")
  estadosMovimentoExtrajudicial          MovimentacaoExtrajudicialEstadoUsuario[]

  @@unique([usuarioId, escritorioId], map: "uq_membros_usuario_escritorio")
  @@index([escritorioId, status], map: "idx_membros_escritorio_status")
  @@index([papelId], map: "idx_membros_papel")
  @@index([escritorioId, cpf], map: "idx_membros_escritorio_cpf")
  @@index([escritorioId, nome], map: "idx_membros_escritorio_nome")
  @@index([cargoId], map: "idx_membros_cargo")
  @@map("membros")
}

model PermissaoUsuario {
  id             String          @id @default(uuid()) @db.Uuid
  membroId       String          @map("membro_id") @db.Uuid
  permissaoId    String          @map("permissao_id") @db.Uuid
  efeito         EfeitoPermissao
  concedidaPorId String          @map("concedida_por_id") @db.Uuid
  expiraEm       DateTime?       @map("expira_em") @db.Timestamptz
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz

  membro    Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([membroId, permissaoId], map: "uq_permissao_usuario")
  @@map("permissoes_usuario")
}

model Convite {
  id             String        @id @default(uuid()) @db.Uuid
  escritorioId   String        @map("escritorio_id") @db.Uuid
  email          String
  papelId        String        @map("papel_id") @db.Uuid
  tokenHash      String        @map("token_hash")
  convidadoPorId String        @map("convidado_por_id") @db.Uuid
  // Preenchido quando o convite é para CONCEDER ACESSO a um colaborador
  // (`Membro`) já cadastrado sem conta — `AcceptInvitationUseCase` atualiza
  // esse `Membro` (define `usuarioId`) em vez de criar um novo. Nulo no
  // fluxo tradicional de convite direto (sem colaborador pré-existente).
  membroId       String?       @map("membro_id") @db.Uuid
  expiraEm       DateTime      @map("expira_em") @db.Timestamptz
  status         StatusConvite @default(PENDENTE)
  aceitoPorId    String?       @map("aceito_por_id") @db.Uuid
  dataAceite     DateTime?     @map("data_aceite") @db.Timestamptz
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm   DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz

  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  convidadoPor Membro     @relation("ConvitesEmitidosPeloMembro", fields: [convidadoPorId], references: [id], onDelete: Restrict)
  membro       Membro?    @relation("ConviteParaMembro", fields: [membroId], references: [id], onDelete: SetNull)

  @@unique([tokenHash], map: "uq_convites_token")
  @@index([escritorioId, email, status], map: "idx_convites_escritorio_email_status")
  @@map("convites")
}

// ============================================================================
// CLIENTS
// ============================================================================

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum StatusCliente {
  ATIVO
  INATIVO
  PROSPECT
}

// Adicionado no Prompt "Clientes e Contatos" — um cadastro pode ser
// tratado como Cliente (parte em processos), Contato (pessoa de referência
// sem processo próprio, ex.: cônjuge, sócio, testemunha) ou os dois ao mesmo
// tempo. Dimensão independente de `TipoCliente` (Pessoa Física/Jurídica) e
// de `StatusCliente` (ciclo de vida) — nunca confundir as três.
enum TipoRelacionamentoCliente {
  CLIENTE
  CONTATO
  CLIENTE_E_CONTATO
}

// Só se aplica a Pessoa Física — mantido como enum fixo (não como Conjunto
// de Valores do Configuration Engine) porque esta Sprint está proibida de
// alterar o Configuration Engine, e o conjunto de opções é um vocabulário
// civil universal, não algo que cada escritório precise customizar.
enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

model Cliente {
  id                      String                    @id @default(uuid()) @db.Uuid
  escritorioId            String                    @map("escritorio_id") @db.Uuid
  tipo                    TipoCliente
  categoriaRelacionamento TipoRelacionamentoCliente @default(CLIENTE) @map("categoria_relacionamento")
  nome                    String
  nomeSocial              String?                   @map("nome_social")
  razaoSocial             String?                   @map("razao_social")
  cpf                     String?
  cnpj                    String?
  rg                      String?
  emails                  String[]                  @default([])
  telefones               String[]                  @default([])
  telefoneResidencial     String?                   @map("telefone_residencial")
  telefoneResponsavel     String?                   @map("telefone_responsavel")
  enderecoLogradouro      String?                   @map("endereco_logradouro")
  enderecoNumero          String?                   @map("endereco_numero")
  enderecoComplemento     String?                   @map("endereco_complemento")
  enderecoBairro          String?                   @map("endereco_bairro")
  enderecoCidade          String?                   @map("endereco_cidade")
  enderecoUf              String?                   @map("endereco_uf") @db.Char(2)
  enderecoCep             String?                   @map("endereco_cep")
  observacoes             String?
  responsavelId           String?                   @map("responsavel_id") @db.Uuid
  responsavelNome         String?                   @map("responsavel_nome")
  status                  StatusCliente             @default(ATIVO)
  // Campos pessoais — só relevantes/preenchidos para Pessoa Física; nulos
  // para Pessoa Jurídica. `nomeMae`/`nomePai`/`dataNascimento` entram em
  // `CLIENT_SENSITIVE_FIELD_RULES` (dado sigiloso, exige
  // `client:read:sensitive`), mesmo tratamento de CPF/endereço.
  avatarUrl               String?                   @map("avatar_url")
  nomeMae                 String?                   @map("nome_mae")
  nomePai                 String?                   @map("nome_pai")
  estadoCivil             EstadoCivil?              @map("estado_civil")
  profissao               String?
  dataNascimento          DateTime?                 @map("data_nascimento") @db.Date
  // Valores dos Campos Extras definidos no Configuration Engine
  // (`CampoExtra`, entidade CLIENTE) — o motor de configuração só define os
  // campos (metadado); os valores por cliente são responsabilidade do
  // próprio módulo Clientes, guardados aqui como `{ [campoExtraId]: valor }`.
  camposExtrasValores     Json                      @default("{}") @map("campos_extras_valores")
  criadoEm                DateTime                  @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm            DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm              DateTime?                 @map("excluido_em") @db.Timestamptz
  // Coluna gerada (GENERATED ALWAYS AS ... STORED) criada via migration SQL
  // manual (prisma/migrations/20260731000002_search_extensions) — declarada
  // aqui apenas para que `prisma migrate dev` não tente removê-la por
  // "drift" (schema.prisma é a única fonte que ele compara). `Unsupported`
  // não é gerenciável pelo Prisma Client; a definição real (expressão de
  // geração, índice GIN) vive só na migration manual.
  buscaTsv                Unsupported("tsvector")?  @map("busca_tsv")

  escritorio                  Escritorio                  @relation(fields: [escritorioId], references: [id], onDelete: Restrict)
  processos                   Processo[]
  // Adicionados na Sprint 11 (Assistente Jurídico Inteligente) — "Histórico
  // Inteligente" do Cliente.
  resumosIa                   ResumoIA[]
  fontesIa                    FonteIA[]
  favoritos                   ClienteFavorito[]
  movimentacoesExtrajudiciais MovimentacaoExtrajudicial[]
  pastasJuridicasPrincipais   PastaJuridica[]             @relation("PastaJuridicaClientePrincipal")
  pastasJuridicasContrarias   PastaJuridica[]             @relation("PastaJuridicaParteContraria")
  vinculosPastasJuridicas     PastaJuridicaCliente[]

  @@index([escritorioId, nome], map: "idx_clientes_escritorio_nome")
  @@index([escritorioId, cpf], map: "idx_clientes_escritorio_cpf")
  @@index([escritorioId, cnpj], map: "idx_clientes_escritorio_cnpj")
  @@index([escritorioId, rg], map: "idx_clientes_escritorio_rg")
  @@index([escritorioId, categoriaRelacionamento], map: "idx_clientes_escritorio_categoria")
  @@map("clientes")
}

// Mesmo padrão de `TarefaFavorito`/`PastaFavorito`/`DocumentoFavorito` —
// favorito é por membro (nunca vaza entre usuários do mesmo escritório).
model ClienteFavorito {
  clienteId String   @map("cliente_id") @db.Uuid
  membroId  String   @map("membro_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@id([clienteId, membroId])
  @@map("cliente_favorito")
}

