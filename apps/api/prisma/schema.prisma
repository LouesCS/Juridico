model Comentario {
  id               String                   @id @default(uuid()) @db.Uuid
  escritorioId     String                   @map("escritorio_id") @db.Uuid
  processoId       String?                  @map("processo_id") @db.Uuid
  documentoId      String?                  @map("documento_id") @db.Uuid
  // Adicionado no Prompt 14 (Task Engine) — comentário de Tarefa, mesmo
  // modelo já usado por Processo/Documento desde a Fase 1, nunca duplicado.
  tarefaId         String?                  @map("tarefa_id") @db.Uuid
  timelineEventoId String?                  @map("timeline_evento_id") @db.Uuid
  autorId          String                   @map("autor_id") @db.Uuid
  conteudo         String
  comentarioPaiId  String?                  @map("comentario_pai_id") @db.Uuid
  editado          Boolean                  @default(false)
  visibilidade     Visibilidade             @default(INTERNA)
  criadoEm         DateTime                 @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm     DateTime                 @updatedAt @map("atualizado_em") @db.Timestamptz
  excluidoEm       DateTime?                @map("excluido_em") @db.Timestamptz
  // Ver nota em Cliente.buscaTsv.
  buscaTsv         Unsupported("tsvector")? @map("busca_tsv")

  processo       Processo?          @relation(fields: [processoId], references: [id], onDelete: Cascade)
  documento      Documento?         @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  tarefa         Tarefa?            @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  timelineEvento EventoTimeline?    @relation(fields: [timelineEventoId], references: [id], onDelete: Cascade)
  comentarioPai  Comentario?        @relation("ComentarioThread", fields: [comentarioPaiId], references: [id], onDelete: Cascade)
  respostas      Comentario[]       @relation("ComentarioThread")
  mencoes        ComentarioMencao[]

  @@index([processoId, criadoEm], map: "idx_comentarios_processo")
  @@index([documentoId, criadoEm], map: "idx_comentarios_documento")
  @@index([tarefaId, criadoEm], map: "idx_comentarios_tarefa")
  @@map("comentarios")
}

