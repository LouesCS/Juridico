// ============================================================================
// AI
// ============================================================================

enum TipoResumoIA {
  GERAL
  EXECUTIVO
  CRONOLOGICO
  PONTOS_CHAVE
  RISCOS
  // Adicionados na Sprint 11 (Assistente Jurídico Inteligente) — o Sprint 11
  // pede "Resumir Documento" e "Histórico Inteligente" de Cliente além do
  // resumo de Processo já contratado (docs/api/14-ai.md). `CRONOLOGICO` já
  // cobre "Explicar a Timeline" (narrativa cronológica do processo), não
  // precisou de um tipo novo.
  RESUMO_DOCUMENTO
  HISTORICO_CLIENTE
  // Adicionados no Prompt 14 (Task Engine) — 5 ações de IA pedidas para
  // Tarefa, todas reaproveitando o mesmo pipeline de `ResumoIA` (cota,
  // cache por hash de contexto, custo estimado) em vez de uma tabela nova.
  TAREFA_RESUMO
  TAREFA_CHECKLIST
  TAREFA_PROXIMOS_PASSOS
  TAREFA_DESCRICAO
  TAREFA_CONTEXTO
}

// Adicionado na Sprint 11 — `ResumoIA.processoId` era `NOT NULL` (só
// cobria resumo de processo); "Resumir Documento"/"Histórico Inteligente do
// Cliente" exigem um escopo diferente. Exatamente um entre
// `processoId`/`documentoId`/`clienteId` é preenchido, de acordo com este
// campo — invariante garantida na aplicação (o use case correspondente),
// não por `CHECK` de banco, mesmo padrão de outras invariantes deste
// projeto (ex.: unicidade de `vigente` por escopo).
enum EscopoResumoIA {
  PROCESSO
  DOCUMENTO
  CLIENTE
  // Adicionado no Prompt 14 (Task Engine).
  TAREFA
}

enum StatusResumoIA {
  PENDENTE
  GERANDO
  PRONTO
  FALHA
  EXPIRADO
}

enum FeedbackResumo {
  POSITIVO
  NEGATIVO
}

enum TipoFonteIA {
  DOCUMENTO
  EVENTO_TIMELINE
  METADADO_PROCESSO
  // Adicionados na Sprint 11 — citar o próprio processo (num Histórico de
  // Cliente) ou o próprio cliente (num Resumo de Documento/Processo) como
  // fonte, agora que `ResumoIA` deixou de ser exclusivo de Processo.
  PROCESSO
  CLIENTE
  // Adicionado no Prompt 14 (Task Engine).
  TAREFA
}

model ResumoIA {
  id                    String          @id @default(uuid()) @db.Uuid
  escritorioId          String          @map("escritorio_id") @db.Uuid
  escopoTipo            EscopoResumoIA  @default(PROCESSO) @map("escopo_tipo")
  // Nullable desde a Sprint 11 — ver nota em `EscopoResumoIA`. Exatamente um
  // entre `processoId`/`documentoId`/`clienteId`/`tarefaId` é preenchido, de
  // acordo com `escopoTipo`.
  processoId            String?         @map("processo_id") @db.Uuid
  documentoId           String?         @map("documento_id") @db.Uuid
  clienteId             String?         @map("cliente_id") @db.Uuid
  tarefaId              String?         @map("tarefa_id") @db.Uuid
  solicitadoPorId       String          @map("solicitado_por_id") @db.Uuid
  tipoResumo            TipoResumoIA    @default(GERAL) @map("tipo_resumo")
  versaoResumo          Int             @map("versao_resumo")
  status                StatusResumoIA  @default(PENDENTE)
  conteudo              String?
  estruturaJson         Json?           @map("estrutura_json")
  modelo                String
  promptVersion         String          @map("prompt_version")
  tokensEntrada         Int?            @map("tokens_entrada")
  tokensSaida           Int?            @map("tokens_saida")
  custoEstimadoCentavos Int?            @map("custo_estimado_centavos")
  hashContexto          String          @map("hash_contexto")
  latenciaMs            Int?            @map("latencia_ms")
  erro                  String?
  feedback              FeedbackResumo?
  comentarioFeedback    String?         @map("comentario_feedback")
  vigente               Boolean         @default(true)
  geradoEm              DateTime?       @map("gerado_em") @db.Timestamptz
  expiraEm              DateTime?       @map("expira_em") @db.Timestamptz
  criadoEm              DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm          DateTime        @updatedAt @map("atualizado_em") @db.Timestamptz

  // `onDelete: Restrict` nas 3 — mesmo racional original (resumo não
  // sobrevive à entidade, mas exclusão é sempre soft delete na prática).
  processo  Processo?  @relation(fields: [processoId], references: [id], onDelete: Restrict)
  documento Documento? @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  cliente   Cliente?   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  tarefa    Tarefa?    @relation(fields: [tarefaId], references: [id], onDelete: Restrict)
  fontes    FonteIA[]

  @@index([processoId, tipoResumo, vigente], map: "idx_resumos_ia_processo_tipo_vigente")
  @@index([documentoId, tipoResumo, vigente], map: "idx_resumos_ia_documento_tipo_vigente")
  @@index([clienteId, tipoResumo, vigente], map: "idx_resumos_ia_cliente_tipo_vigente")
  @@index([tarefaId, tipoResumo, vigente], map: "idx_resumos_ia_tarefa_tipo_vigente")
  @@index([status], map: "idx_resumos_ia_status")
  @@index([escritorioId, criadoEm], map: "idx_resumos_ia_escritorio_periodo")
  @@map("resumos_ia")
}

model FonteIA {
  id                 String      @id @default(uuid()) @db.Uuid
  resumoIaId         String      @map("resumo_ia_id") @db.Uuid
  sourceType         TipoFonteIA @map("source_type")
  documentoId        String?     @map("documento_id") @db.Uuid
  eventoTimelineId   String?     @map("evento_timeline_id") @db.Uuid
  // Adicionados na Sprint 11 — citar processo/cliente como fonte (ver nota em `TipoFonteIA`).
  processoId         String?     @map("processo_id") @db.Uuid
  clienteId          String?     @map("cliente_id") @db.Uuid
  // Adicionado no Prompt 14 (Task Engine).
  tarefaId           String?     @map("tarefa_id") @db.Uuid
  hashFonte          String      @map("hash_fonte")
  ordem              Int
  trechoOuReferencia String?     @map("trecho_ou_referencia")
  criadoEm           DateTime    @default(now()) @map("criado_em") @db.Timestamptz

  resumoIa       ResumoIA        @relation(fields: [resumoIaId], references: [id], onDelete: Cascade)
  documento      Documento?      @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  eventoTimeline EventoTimeline? @relation(fields: [eventoTimelineId], references: [id], onDelete: SetNull)
  processo       Processo?       @relation(fields: [processoId], references: [id], onDelete: SetNull)
  cliente        Cliente?        @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  tarefa         Tarefa?         @relation(fields: [tarefaId], references: [id], onDelete: SetNull)

  @@index([resumoIaId, ordem], map: "idx_fontes_ia_resumo")
  @@map("fontes_ia")
}

